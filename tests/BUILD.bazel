load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("//:tools/bazel/native.bzl", "WPA_INCLUDE_COPTS")

package(default_visibility = ["//:__pkg__"])

filegroup(
    name = "source_files",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

# Preserve the fixed WPA flags and the tests/Makefile configuration inherited
# by upstream library builds. Bazel owns dependency-file generation. Disabling
# the toolchain-added extra warnings matches the existing frontend filter.
_TEST_COPTS = WPA_INCLUDE_COPTS + [
    "-O2",
    "-g",
    "-Wall",
    "-Wno-extra",
    "-U_FORTIFY_SOURCE",
    "-D_FORTIFY_SOURCE=3",
    "-fstack-protector-strong",
    "-Wformat",
    "-Werror=format-security",
    "-Wno-error=array-bounds",
    "-Wno-deprecated-declarations",
    "-Wno-use-after-free",
    "-Wno-discarded-qualifiers",
    "-DCONFIG_IEEE80211R_AP",
    "-DCONFIG_IEEE80211R",
    "-DCONFIG_TDLS",
]

_TEST_LINKOPTS = [
    "-Wl,--as-needed",
    "-Wl,-z,relro",
    "-Wl,-z,now",
    "-lrt",
]

_SUPPORTED_PLATFORM = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
    "@sonic_build_infra//platforms:trixie",
]


        "//:src/utils/edit.c",
    ],
    copts = _TEST_COPTS + [
        "-DCONFIG_IPV6",
        "-DCONFIG_DEBUG_FILE",
        "-fPIC",
    ],
    target_compatible_with = _SUPPORTED_PLATFORM,
    deps = ["//:private_headers"],

# Upstream links crypto and TLS in --start-group: each calls into the other.
# Merge their native object files into one archive so ordinary archive rescans
# resolve that cycle. The original libraries retain their separate compile flags;
# unused objects remain unlinked, as they do with the upstream archive group.
cc_static_library(
    name = "crypto_tls_archive",
    testonly = True,
    deps = [":crypto", ":tls"],
    target_compatible_with = _SUPPORTED_PLATFORM,
)

# cc_static_library publishes an archive rather than CcInfo. A native library
# consumes that archive and supplies the existing private header interface.
cc_library(
    name = "crypto_tls",
    testonly = True,
    srcs = [":crypto_tls_archive"],
    deps = ["//:private_headers"],
    target_compatible_with = _SUPPORTED_PLATFORM,
)

_TEST_DEPS = [
    ":crypto_tls",
    ":utils",
]


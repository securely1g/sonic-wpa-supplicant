"""Native builds for the fixed Debian Linux WPA configuration."""

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

# SONiC fixes Debian's Linux configuration; upstream optional settings are not
# new product switches. These are its effective flags, shared by the three
# installed programs. Native rules consume the original source files directly.
# Preserve the upstream -I ordering ahead of dependency system include paths.
# Label.workspace_root also resolves correctly when this owner is imported.
_SOURCE_ROOT = Label("//:BUILD.bazel").workspace_root
_SOURCE_PREFIX = _SOURCE_ROOT + "/" if _SOURCE_ROOT else ""

WPA_INCLUDE_COPTS = [
    "-I" + _SOURCE_PREFIX + "src",
    "-I" + _SOURCE_PREFIX + "src/utils",
]

_WPA_COPTS = WPA_INCLUDE_COPTS + [
    "-O2",
    "-g",
    "-Wall",
    # The original frontend removes the toolchain default -Wextra.
    "-Wno-extra",
    "-U_FORTIFY_SOURCE",
    "-D_FORTIFY_SOURCE=3",
    "-fstack-protector-strong",
    "-Wformat",
    "-Werror=format-security",
    "-Wno-error=array-bounds",
    "-Wno-deprecated-declarations",
    "-Wno-use-after-free",
    "-Werror",
    "-DEAPOL_TEST",
